{
  "name": "sponge-bob-tun",
  "version": "1.1.0",
  "description": "Sponge bob tun (باب اسفنجی) — Modern bilingual Persian/English Windows VLESS Xray local proxy desktop client (Electron & Rust/Tauri v2)",
  "author": "Manixpcshot",
  "license": "MIT",
  "homepage": "https://github.com/Manixpcshot/Sponge-Bob-TUN",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manixpcshot/Sponge-Bob-TUN.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "dev:tauri": "tauri dev",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "build:tauri": "tauri build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "xray:download": "node scripts/download-xray.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.546.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
